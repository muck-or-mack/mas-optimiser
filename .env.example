# Copy to .env (gitignored) and fill in; the runner reads it at start-up.
#
# One line a value, as NAME=value, with no spaces around the equals sign.
# Quotation marks are not needed. Fill in only the lines of the models to be
# used; a blank line is a value not set. Each model file in configs/models/
# names the variables it needs, so several keys sit here side by side and
# the model chosen for a run (--model) decides which are read.

# configs/models/haiku-5-5.yaml: a key of the Claude API, which begins sk-ant-
ANTHROPIC_API_KEY=

# configs/models/gpt-5.1-azure.yaml: one's own Azure OpenAI resource.
# The key of the resource:
AZURE_OPENAI_API_KEY=
# Its address, of the form https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
# The name of the deployment of the model, as its owner named it:
AZURE_OPENAI_DEPLOYMENT=
# The version of the API, a date such as 2025-04-01-preview:
AZURE_OPENAI_API_VERSION=

# The five model files ending in -azure-multi.yaml: one Azure resource that
# serves several models, reached by its route in the OpenAI API's own format.
# The key of the resource:
AZURE_MULTIMODEL_API_KEY=
# Its address for that route, which ends in /openai/v1:
AZURE_MULTIMODEL_ENDPOINT=

# configs/models/qwen3.6-27b-fp8.yaml and qwen3.6-27b.yaml need nothing here:
# a server on one's own machine asks for no key.

# Optional: a Langfuse project's keys and host. Leave blank to run without
# tracing. For a self-hosted instance the host is http://localhost:3000.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
