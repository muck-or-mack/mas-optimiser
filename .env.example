# Copy to .env (gitignored) and fill in; the runner reads it at start-up.
ANTHROPIC_API_KEY=

# Optional: a Langfuse project's keys and host. Leave blank to run without
# tracing. For a self-hosted instance the host is http://localhost:3000.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
